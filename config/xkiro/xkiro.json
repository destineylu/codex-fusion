{
  "version": 1,
  "providers": [
    {
      "id": "xkiro",
      "displayName": "Xkiro API",
      "kind": "openai-compatible",
      "ownedBy": "xkiro",
      "baseUrl": "https://api.xkiro.com/v1",
      "baseUrlEnv": "XKIRO_API_BASE_URL",
      "credential": {
        "environment": [
          "XKIRO_API_KEY"
        ],
        "file": "xkiro-api-key.secret",
        "legacyFiles": [],
        "keychainServices": [
          "codex-router-xkiro"
        ],
        "prompt": "Xkiro API key"
      }
    }
  ]
}
